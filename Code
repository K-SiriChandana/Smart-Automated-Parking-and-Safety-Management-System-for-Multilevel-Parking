

#include <Servo.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

Servo gate;
LiquidCrystal_I2C lcd(0x27,16,2);

// Ultrasonic pins
int trig = 9;
int echo = 10;

// Slot sensors
int slot1 = 2;
int slot2 = 3;
int slot3 = 4;
int slot4 = 5;

// RGB LEDs
int red1 = 7;
int green1 = 8;

int red2 = 11;
int green2 = 12;

int red3 = 13;
int green3 = A0;

int red4 = A1;
int green4 = A2;

long duration;
int distance;

// -------- STATE MACHINE --------
enum State
{
  IDLE,
  CAR_DETECTED,
  OPEN_GATE,
  WAIT_FOR_CAR,
  CLOSE_GATE
};

State currentState = IDLE;

void setup()
{
  Serial.begin(9600);

  // LCD setup
  lcd.init();
  lcd.backlight();

  lcd.setCursor(0,0);
  lcd.print("Smart Parking");

  lcd.setCursor(0,1);
  lcd.print("System Ready");

  delay(2000);
  lcd.clear();

  pinMode(trig, OUTPUT);
  pinMode(echo, INPUT);

  pinMode(slot1, INPUT_PULLUP);
  pinMode(slot2, INPUT_PULLUP);
  pinMode(slot3, INPUT_PULLUP);
  pinMode(slot4, INPUT_PULLUP);

  pinMode(red1, OUTPUT);
  pinMode(green1, OUTPUT);

  pinMode(red2, OUTPUT);
  pinMode(green2, OUTPUT);

  pinMode(red3, OUTPUT);
  pinMode(green3, OUTPUT);

  pinMode(red4, OUTPUT);
  pinMode(green4, OUTPUT);

  gate.attach(6);
  gate.write(0);

  Serial.println("System Started");
}

void loop()
{
  // -------- ULTRASONIC SENSOR --------

  digitalWrite(trig, LOW);
  delayMicroseconds(2);

  digitalWrite(trig, HIGH);
  delayMicroseconds(10);

  digitalWrite(trig, LOW);

  duration = pulseIn(echo, HIGH);
  distance = duration * 0.034 / 2;

  // -------- READ SLOT SENSORS --------

  int s1 = digitalRead(slot1);
  int s2 = digitalRead(slot2);
  int s3 = digitalRead(slot3);
  int s4 = digitalRead(slot4);
  
Serial.print("S1: ");
Serial.print(s1);
Serial.print("  S2: ");
Serial.print(s2);
Serial.print("  S3: ");
Serial.print(s3);
Serial.print("  S4: ");
Serial.println(s4);


  // LED control
  controlLED(s1, red1, green1);
  controlLED(s2, red2, green2);
  controlLED(s3, red3, green3);
  controlLED(s4, red4, green4);

  // -------- COUNT FREE SLOTS --------

  int freeSlots = 0;

  if(s1 == HIGH) freeSlots++;
  if(s2 == HIGH) freeSlots++;
  if(s3 == HIGH) freeSlots++;
  if(s4 == HIGH) freeSlots++;

  Serial.print("Free Slots: ");
  Serial.println(freeSlots);

  // -------- LCD DISPLAY --------

  lcd.setCursor(0,0);
  lcd.print("Free Slots: ");
  lcd.print(freeSlots);
  lcd.print(" ");

  if(freeSlots == 0)
  {
    lcd.setCursor(0,1);
    lcd.print("Parking FULL ");
  }
  else
  {
    lcd.setCursor(0,1);
    lcd.print("Waiting Car  ");
  }

  // -------- STATE MACHINE --------

  switch(currentState)
  {

    case IDLE:

      if(distance < 10)
      {
        Serial.println("Car detected");
        currentState = CAR_DETECTED;
      }

    break;


    case CAR_DETECTED:

      if(freeSlots > 0)
      {
        Serial.println("Opening Gate");

        lcd.setCursor(0,1);
        lcd.print("Opening Gate ");

        gate.write(90);

        currentState = OPEN_GATE;
      }
      else
      {
        Serial.println("Parking Full");
      }

    break;


    case OPEN_GATE:

      delay(3000);
      currentState = WAIT_FOR_CAR;

    break;


    case WAIT_FOR_CAR:

      if(distance > 15)
      {
        Serial.println("Car Entered");
        currentState = CLOSE_GATE;
      }

    break;


    case CLOSE_GATE:

      Serial.println("Closing Gate");

      lcd.setCursor(0,1);
      lcd.print("Closing Gate ");

      gate.write(0);

      delay(2000);

      currentState = IDLE;

    break;

  }

  delay(200);
}


// -------- LED CONTROL FUNCTION --------

void controlLED(int sensor, int red, int green)
{
  if(sensor == LOW)
  {
    digitalWrite(red, HIGH);
    digitalWrite(green, LOW);
  }
  else
  {
    digitalWrite(red, LOW);
    digitalWrite(green, HIGH);
  }
}
